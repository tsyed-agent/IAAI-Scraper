# Required — generate: openssl rand -hex 32
IAAI_API_TOKEN=change-me-to-a-long-random-secret
# Optional but recommended: separate token for POST /commands/*.
IAAI_COMMAND_TOKEN=change-me-to-a-different-long-random-secret
# Readiness fails when the latest completed crawl is older than this.
IAAI_MAX_DATA_AGE_HOURS=24

# On-demand thumbnail cache (API only; crawl never downloads images).
IAAI_IMAGE_CACHE=true
# IAAI_IMAGE_CACHE_DIR=data/image_cache
# IAAI_IMAGE_ALLOWED_HOSTS=anvis.iaai.com,vis.iaai.com
# IAAI_IMAGE_FETCH_TIMEOUT=15
# IAAI_IMAGE_CACHE_MAX_BYTES=2000000
# IAAI_IMAGE_NEGATIVE_TTL=600        # seconds before retrying a failed source URL
# IAAI_IMAGE_CACHE_TTL=2592000       # evict thumbs untouched for 30 days (0 = keep)
# IAAI_MEDIA_URL_TTL=900             # signed thumbnail_href lifetime (seconds)

# Allow unauthenticated GET /readyz for LB/orchestrator probes (safe: counts only).
# IAAI_READYZ_PUBLIC=false

# Host port (container always listens on 8000). Binds 127.0.0.1 only.
IAAI_API_PORT=8000

# External scheduler wrapper (scripts/scheduled_crawl.sh).
# IAAI_SCHED_RETRY_DELAY_S=1200  # nonnegative seconds before one retry
# IAAI_SCHED_JITTER_S=300        # random startup delay maximum; 0 disables

# Off-host backups (scripts/offsite_backup.sh / cli offsite-backup).
# IAAI_BACKUP_BACKEND=filesystem   # or s3 (requires boto3)
# IAAI_BACKUP_DIR=data/offsite     # filesystem object-store root
# IAAI_BACKUP_S3_BUCKET=
# IAAI_BACKUP_S3_ENDPOINT=         # MinIO / R2 / B2
# IAAI_BACKUP_S3_REGION=
# IAAI_BACKUP_S3_PREFIX=iaai-ontario
# IAAI_BACKUP_KEEP_LOCAL_DB=5
# IAAI_BACKUP_RAW_HOT_DAYS=90
# IAAI_BACKUP_MIN_LOTS=1
# IAAI_BACKUP_SKIP_DRILL=0
# IAAI_BACKUP_ALERT_HOOK=
